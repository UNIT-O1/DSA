/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    ListNode *detectCycle(ListNode *head) {
        
        ListNode* fast=head;
        ListNode* slow=head;
        do
        {
            if(fast==nullptr || fast->next==nullptr)
            return nullptr;
            slow=slow->next;
            fast=fast->next->next;
        }while(slow!=fast);

        ListNode* temp=head;
        while(slow!=temp){
            temp=temp->next;
            slow=slow->next;
        }

        return temp;

    }
};
